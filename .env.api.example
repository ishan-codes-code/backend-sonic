# API environment variables
PORT=3000
DATABASE_URL=postgresql://user:password@ep-name.region.aws.neon.tech/dbname?sslmode=require

# Storage mode: "r2" (default when missing) or "local" (serve ~/songs from this host)
STORAGE_MODE=r2

# JWT
JWT_ACCESS_SECRET=your-secure-access-secret
JWT_REFRESH_SECRET=your-secure-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_PLAYBACK_SECRET=your-secure-playback-secret

# External services
YOUTUBE_API_KEY=your-youtube-data-api-key
LASTFM_API_KEY=your-lastfm-api-key
WORKER_URL=http://localhost:3001
WORKER_SECRET=your-shared-secret
WORKER_STREAM_SECRET=your-long-random-secret-here
WORKER_STREAM_URL=https://your-worker.workers.dev
API_CORS_ORIGIN=http://localhost:3000

# R2 storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=your-r2-bucket
