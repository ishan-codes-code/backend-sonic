# Worker environment variables
WORKER_PORT=3001
DATABASE_URL=postgresql://user:password@ep-name.region.aws.neon.tech/dbname?sslmode=require
WORKER_SECRET=your-shared-secret
WORKER_CORS_ORIGIN=http://localhost:3000

# Storage mode: "r2" (default when missing) or "local" (read ~/songs from this host).
# The worker follows the same saved value as the API after setup.
STORAGE_MODE=r2

# Optional worker-specific resources
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=your-r2-bucket
